# Ключ OpenAI-совместимого API (OpenAI, OpenRouter, LM Studio, Ollama и т.п.).
# Пустое значение позволяет запустить сервис: вызов модели вернёт fallback.
LLM_API_KEY=

# Необязательные переопределения. Если строка закомментирована, берётся config/settings.yaml.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=15
# LLM_MAX_ATTEMPTS=3
# CACHE_TTL_SECONDS=600
